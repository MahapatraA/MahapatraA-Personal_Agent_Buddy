# Buddy environment configuration example.
# Copy this file to .env and fill in your own values.
# Never commit real credentials, API keys, passwords, or tokens.

# Runtime
NODE_ENV=development
PORT=3000

# Data stores
# Local development example. Change "change_me" to match POSTGRES_PASSWORD.
DATABASE_URL=postgresql://buddy:change_me@localhost:5432/buddy
REDIS_URL=

# Authentication
JWT_SECRET=

# Google OAuth (Gmail / Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Firebase Cloud Messaging
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# AI provider
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
